# Скопируйте в .env (он в .gitignore) и заполните. Используется docker-compose.app.yml.
# Ненужные строки оставляйте закомментированными: строка вида GEMINI_MODEL= задаёт ПУСТОЕ
# значение, и сервер не подставит своё по умолчанию (список и умолчания в docs/setup.md).

TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
# gemini | claude | ollama
#AI_PROVIDER=ollama
#GEMINI_MODEL=gemini-3.5-flash-lite
#ANTHROPIC_API_KEY=
#CLAUDE_MODEL=claude-opus-5-5

# Ollama на Windows; адрес host.docker.internal:11434 подставляет docker-compose.app.yml
#OLLAMA_MODEL=qwen3:14b
#OLLAMA_VISION_MODEL=qwen2.5vl:7b
#OLLAMA_NUM_CTX=8192
#OLLAMA_THINK=false
#OLLAMA_KEEP_ALIVE=30m

# База: адрес finances_db задаёт docker-compose.app.yml; пароль — только если меняли
#DB_PASSWORD=change_me_please

#BACKUP_KEEP=12
#BACKUP_DISABLED=true
